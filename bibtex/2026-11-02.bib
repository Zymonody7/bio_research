@article{Spottiswoode2026plasma-mNGS-pathogen,
  title = {Clinical Impact, Diagnostic Performance, and Prognostic Implications of Plasma Metagenomic Next-Generation Sequencing in Solid Organ Transplant Recipients},
  author = {Spottiswoode Natasha and Marra Pedro S. and Lydon Emily C. and Chu Victoria T. and Radakovich Nathan and Rodriguez Julieta and Phan Hoang Van and Langelier Charles R.},
  journal = {medRxiv : the preprint server for health sciences},
  doi = {10.64898/2026.07.02.26357172},
  year = {2026},
  keywords = {mNGS-pathogen},
  abstract = { Abstract Background Plasma metagenomic next-generation sequencing (mNGS) may detect pathogens in solid organ transplant (SOT) recipients, but optimal patient selection and result interpretation remain uncertain. Methods We studied 145 SOT recipients who received Karius plasma mNGS testing between 2017-2025. Retrospective multi-physician adjudication assessed diagnostic accuracy, clinical impact, and outcomes. We examined whether detection of atypical bacteria, invasive fungi, adenovirus/parvovirus and parasites, termed pre-specified organisms of presumed significance (POPS), predicted positive clinical impact. We applied a GPT-4o large language model (LLM) to limited electronic medical record (EMR) data to identify patients with POPS diagnoses and positive-impact testing. Results Of 145 SOT recipients, 119 (82.1\%) had positive tests, and 42 (29.0\%) had ≥1 POPS organism detected. Twenty-seven of 133 diagnoses (20.3\%) were made by mNGS first or mNGS only. Diagnostic performance versus a gold standard of all microbiologic testing varied by organism, ranging from 100\% sensitivity and specificity ( Bartonella, Nocardia ) to 60.0\% and 53.3\% sensitivity for Coccidioides and Aspergillus, respectively. Of 141 patients with interpretable test impact, 27 (19.1\%) had positive clinical impact, associated with POPS detection (P<0.001). The LLM identified patients with POPS diagnoses (area under the receiver operating characteristic curve [AUC] 0.86), and patients with positive-impact testing (AUC 0.71). Conclusions Plasma mNGS can aid diagnosis and management of infections in},
  url = {https://doi.org/10.64898/2026.07.02.26357172}
}

@article{Chen2026genomic-surveillance-mNGS-pathogen,
  title = {Genomic Surveillance of Respiratory Pathogens: From Molecular Detection to Precision Infection Control.},
  author = {Chen J and Zou Q and Pan B and Zhang Y},
  journal = {Pathogens (Basel, Switzerland)},
  doi = {10.3390/pathogens15101044},
  pmid = {42931196},
  year = {2026},
  keywords = {mNGS-pathogen},
  abstract = {Respiratory pathogens remain a major global public health concern due to factors including their genetic diversity, dynamic transmission patterns, and increasing antimicrobial resistance. Conventional molecular diagnostics, particularly polymerase chain reaction (PCR)-based assays, remain essential for rapid and scalable pathogen detection but provide limited information on pathogen evolution, transmission, and resistance mechanisms. Advances in whole-genome sequencing (WGS), targeted sequencing, and metagenomic next-generation sequencing (mNGS) have expanded respiratory pathogen surveillance from targeted detection toward higher-resolution genomic characterization. However, no single technology can adequately address all surveillance objectives. Instead, molecular diagnostics, genomic sequencing, epidemiological investigation, and clinical assessment provide complementary information that can be integrated according to the pathogen, clinical context, and specific public health question. This review examines the evolution of respiratory pathogen surveillance and emphasizes an integrated framework in which different technologies are selected and combined to support pathogen characterization, transmission investigation, antimicrobial resistance surveillance, and preventive decision-making. We further discuss emerging applications of artificial intelligence (AI) for integrating genomic, epidemiological, and clinical data, with potential roles in genomic interpretation, early risk assessment, and precision infection control. Although AI-enhanced surveillance remains largely at },
  url = {https://pubmed.ncbi.nlm.nih.gov/42931196/}
}

@article{Sagar2026ai-mag-reconstruction-mNGS-pathogen,
  title = {Artificial intelligence in metagenome-assembled genome reconstruction: Tools, pipelines, and future directions.},
  author = {Sagar K and Priti K and Chandra H},
  journal = {Journal of microbiological methods},
  doi = {10.1016/j.mimet.2026.107390},
  pmid = {41506577},
  year = {2026},
  keywords = {mNGS-pathogen},
  abstract = {Metagenomic sequencing has revolutionised the field of microbial ecology, as it has led to cultivation-independent exploration of complicated microbial communities. The assembly of metagenome-assembled genomes has provided genome-scale information about uncultivated microorganisms, but issues such as sequencing errors, fragmented assemblies, residual redundancy, uneven coverage, recovery of low-abundance taxa, and highly diversified taxa continue to impair the quality of these genomes. The latest achievements in artificial intelligence, particularly in machine learning and deep learning, have played a significant role in overcoming these limitations by enhancing quality control, error correction, assembly, binning, refinement, and annotation procedures. It is demonstrated that representation learning and graph-based binning methods have high strain-level resolution and can reduce contamination in complex microbial communities, whereas artificial intelligence-based assemblers and polishing tools improve base-level precision and assembly contiguity. This review synthesises traditional and artificial intelligence-based workflows involved in the reconstruction of metagenome-assembled genomes, encompassing quality control, assembly, binning, refinement, and annotation, as well as quantitative benchmarking of significant artificial intelligence-based pipelines. As future directions, the focus on emerging trends, such as explainable artificial intelligence, federated learning, cloud-native scalable pipelines, multimodal and multi-omics integration, and large language model-based a},
  url = {https://pubmed.ncbi.nlm.nih.gov/41506577/}
}

@article{Wang2026marg-guideline-clinical-agent-RAG,
  title = {Multi-agent AI for liver disease guideline development and maintenance: a proof-of-concept study},
  author = {Wang Xiaoxiao and Wen Xin and Xue Tianyi and Yin Ke and Wang Yafan and Ma Cuiling and Ma Hui and Huang Rui},
  journal = {Communications medicine},
  doi = {10.1038/s43856-026-01961-4},
  year = {2026},
  keywords = {clinical-agent-RAG},
  abstract = {Background: While clinical guidelines remain essential for standardizing medical care, their utility decays as manual updating fails to keep pace with the exponential growth in medical evidence. We developed a Multi-Agent Retrieval-Augmented Generation (MARG) system dedicated to clinical guideline development and maintenance. Methods/Results: Across seven 2025 liver disease guidelines and 137 clinical scenarios, MARG achieved 77.4\% overall concordance (45.8\% under weak consensus rising to 87.8\% at full consensus); domain performance 65.5\% diagnosis, 75.0\% prevention, 81.0\% treatment. MARG outperformed manual evidence review in recency (6.3\% vs 0.9\%), reproducibility (25.5\% vs 7.5\%) and quality (24.2\% vs 8.0\% Level I evidence); four rounds of structured debate resolved 95.8\% of recommendation conflicts; in a 60-scenario physician simulation MARG corrected 40-60\% of guideline-inconsistent decisions, net gain 50\% strongest for early-career physicians. Conclusions: Proof-of-concept findings suggest MARG may support guideline development and maintenance, contingent on tiered human-AI collaboration, curated evidence repositories, machine-interpretable grading protocols and independent governance.},
  url = {https://doi.org/10.1038/s43856-026-01961-4}
}

@article{Reddy2026care-med-clinical-agent-RAG,
  title = {Hybrid retrieval–verification framework for hallucination reduction in medical LLMs},
  author = {Reddy Sudheer and Samreen Shirina},
  journal = {Scientific reports},
  doi = {10.1038/s41598-026-75909-y},
  year = {2026},
  keywords = {clinical-agent-RAG},
  abstract = {Clinicians use Large Language Models (LLMs) for clinical decision support, medical question answering and automated document writing, but models can hallucinate and pose safety risks. While Retrieval-Augmented Generation (RAG) improves factuality, it does not always produce outputs consistent with supporting evidence. This study reframes NLI-based unsupported-response rate mitigation as a confidence-aware inference problem and proposes a unified CARE-Med framework for retrieval, generation and verification, leveraging dense retrieval, natural language inference verifiers and a confidence scoring mechanism. Validated on MIMIC-III, PubMedQA and BioASQ, the method reduces NLI-based unsupported-response rate from 32\% for the baseline LLM to 10\% for CARE-Med (22 percentage points, 68.8\% relative reduction); compared with conventional RAG the rate decreases from 21\% to 10\% (11 points, 52.4\% relative reduction).},
  url = {https://doi.org/10.1038/s41598-026-75909-y}
}

@article{Jabbar2026medagent-rag-clinical-agent-RAG,
  title = {MedAgent-RAG: an agentic retrieval-augmented system for adaptive clinical history-taking, with a network analysis of medical interviews},
  author = {Jabbar Samir and Bertolim Maria Alice and Cruz Christophe},
  journal = {Research Square preprint},
  doi = {10.21203/rs.3.rs-11252270/v1},
  year = {2026},
  keywords = {clinical-agent-RAG},
  abstract = { Abstract Automated history-taking in telemedicine has to collect a structured record of a patient’s complaint over many turns while adapting to what the patient answers. MedAgent-RAG is a multi-agent system, implemented as a LangGraph state graph, which keeps an explicit clinical state the slots gathered so far, a ranked differential diagnosis, the questions already asked, the red flags detected, and the current questioning phase, and selects every question as a function of that state, before grounding its final assessment in clinical guidelines retrieved by a parent–child retrieval-augmented pipeline. Evaluated on the MediTOD corpus with a language-model patient simulator, the system raises BERTScore F1 from 0.68 to 0.84 over a single-shot baseline. Beyond that system description, we study history-taking itself as a network problem. From 231 annotated interviews, we build a bipartite network of symptoms and differential diagnoses whose links are statistically validated against a hypergeometric null model, its one-mode projections, and questioning-flow networks over the topics physicians ask about. The knowledge network separates into 8 syndromic modules (bipartite modularity 0.70, z = 5.4) and is less nested than a degree-preserving null model (z = −6.4): the knowledge an interview must cover is compartmentalised rather than hierarchical. Frequent symptoms such as cough and dyspnoea bridge those modules and carry little information about the differential, whereas rarer findings such as haemoptysis, dysphagia and weight loss carry most of it. Physician questioning separate},
  url = {https://doi.org/10.21203/rs.3.rs-11252270/v1}
}

@article{Kaur2026gold-dpo-RLHF-medical-alignment,
  title = {Gold-standard-guided direct preference optimisation for ICD-10-AM and ACHI code assignment from discharge summaries.},
  author = {Kaur R and Ginige JA and Obst O},
  journal = {BMC medical informatics and decision making},
  doi = {10.1186/s12911-026-03631-w},
  pmid = {42902234},
  year = {2026},
  keywords = {RLHF-medical-alignment},
  abstract = {Clinical codes assigned from discharge summaries support clinical research, reimbursement, health resource allocation, and service planning. In Australia, ICD-10-AM and ACHI are used to code diagnoses and interventions for admitted episodes of care, but manual coding is time-consuming, labour-intensive, and subject to variability. This study investigates large language models for automated ICD-10-AM and ACHI code assignment from discharge summaries. We first normalised a public ICD-9-CM coded dataset into the Australian coding system using General Equivalence Mappings and semantic similarity over code descriptions, with validation by a domain expert clinical coder. We then fine-tuned Meta-Llama-3-8B and compared full-parameter fine-tuning with a parameter-efficient QLoRA baseline. Finally, we applied Direct Preference Optimisation (DPO) using gold-standard-guided preference pairs, where the gold-standard ICD-10-AM/ACHI code list was treated as the preferred response and the supervised fine-tuned model output as the non-preferred response. Experiments were conducted on a mapped MIMIC-III subset and a de-identified Australian hospital dataset. Among the evaluated model variants, the DPO-aligned full-parameter model achieved the highest score, with micro-F1 scores of 0.7397 on the mapped dataset and 0.7834 on the Australian hospital dataset. These findings suggest that gold-standard-guided DPO can improve agreement with reference code sets compared with supervised fine-tuning alone. However, the results are limited to high-frequency diagnosis and procedure codes, short-documen},
  url = {https://pubmed.ncbi.nlm.nih.gov/42902234/}
}

@article{Li2026chexpo-v2-RLHF-medical-alignment,
  title = {CheXPO-v2: Preference Optimization for Chest X-ray VLMs with Knowledge Graph Consistency},
  author = {Xiao Liang and Yuxuan An and Di Wang and Jiawei Hu and Zhicheng Jiao and Bin Jing and Quan Wang},
  journal = {arXiv (Cornell University)},
  doi = {10.48550/arxiv.2512.17213},
  eprint = {2512.17213},
  year = {2025},
  keywords = {RLHF-medical-alignment},
  abstract = {Medical Vision-Language Models (VLMs) are prone to hallucinations, compromising clinical reliability. While reinforcement learning methods like Group Relative Policy Optimization (GRPO) offer a low-cost alignment solution, their reliance on sparse, outcome-based rewards inadvertently encourages models to "overthink" -- generating verbose, convoluted, and unverifiable Chain-of-Thought reasoning to justify answers. This focus on outcomes obscures factual errors and poses significant safety risks. To address this, we propose CheXPO-v2, a novel alignment framework that shifts from outcome to process supervision. Our core innovation is a Knowledge Graph Consistency Reward mechanism driven by Entity-Relation Matching. By explicitly parsing reasoning steps into structured "Disease, Relation, Anatomy" triplets, we provide fine-grained supervision that penalizes incoherent logic and hallucinations at the atomic level. Integrating this with a hard-example mining strategy, our approach significantly outperforms GRPO and state-of-the-art models on benchmarks like MIMIC-CXR-VQA. Crucially, CheXPO-v2 achieves new state-of-the-art accuracy using only 5k samples, demonstrating exceptional data efficiency while producing clinically sound and verifiable reasoning. The project source code is publicly available at: https://github.com/ecoxial2007/CheX-Phi4MM.},
  url = {https://arxiv.org/abs/2512.17213}
}

@article{Bass2026gfm-common-variant-genomic-foundation-model,
  title = {Genomic foundation models do not yet boost common variant discovery beyond standard functional annotations},
  author = {Bass Andrew J. and Park Joshua and Mukherjee Sach and Whittaker John and Wallace Chris},
  journal = {bioRxiv (Cold Spring Harbor Laboratory)},
  doi = {10.64898/2026.10.13.758880},
  year = {2026},
  keywords = {genomic-foundation-model},
  abstract = { Abstract Genomic foundation models (GFMs) use large-scale AI to model genetic sequences and their influence on molecular phenotypes. While GFMs have shown promise in rare variant analysis, their utility for common variant discovery remains untested. Using the surrogate functional false discovery rate framework for functionally informed GWAS discovery, we compared standard functional annotations (baselineLD) with annotations derived from three leading GFMs: the sequence-to-function models AlphaGenome and Borzoi, and the genomic language model GPN-Star. Across 27 UK Biobank traits, GPN-Star decreased locus discovery relative to a standard GWAS, whereas AlphaGenome and Borzoi increased discovery but by less than baselineLD (medians 1.8\%, 3.8\%, and 5.1\%). When we combined the GFM and baselineLD annotations, there was no increase over baselineLD alone (median changes −0.1\% to 0.2\%), suggesting that AlphaGenome and Borzoi mostly capture information already in baselineLD. Thus, GFMs may require larger corpora or trait-specific feature engineering to improve discovery beyond standard functional annotations. },
  url = {https://doi.org/10.64898/2026.10.13.758880}
}

@article{Hie2026few-shot-regulatory-genomic-foundation-model,
  title = {Few-shot regulatory sequence design with a genomic language model},
  author = {Hie Brian and Hao Yukun A and Liu Matthew and Nori Divya and Brixi Garyk and Lau Thomas and Ramakrishnan Charu A and Chang Daniel},
  journal = {bioRxiv (Cold Spring Harbor Laboratory)},
  doi = {10.64898/2026.10.28.762639},
  year = {2026},
  keywords = {genomic-foundation-model},
  abstract = { A central challenge in generative biology is translating knowledge learned from natural sequences and experiments into designs with desired functions. In-context learning (ICL) is an emergent capability of large language models that allows them to adapt to new tasks from a few examples without additional training, enabling these models to become general-purpose learners. Here, we show that the genome language model, Evo 2, exhibits generative ICL in biological sequence design. Prompting with just tens of examples conditions Evo 2 to generate novel and diverse regulatory DNA sequences without any additional training. Mechanistic analysis suggests that genomic ICL may originate from induction, similar to phenomena observed in natural language. Reinforcement learning leveraging sequence-to-function models as experiment-derived rewards further strengthens ICL. We first validate this approach by generating enhancers that drive cell-type-specific gene expression in three human cell lines. Extending this approach in vivo, enhancers designed using human regulatory element data selectively label layer 5 extratelencephalic neurons in the mouse cortex with high specificity and stronger activity than existing enhancers. Our study provides evidence of emergent properties in genomic sequence models and introduces a promising approach for improving functional conditioning in generative biology. },
  url = {https://doi.org/10.64898/2026.10.28.762639}
}

@article{Yang2026creator1-plant-genomic-foundation-model,
  title = {Creator 1.0: Phylogeny-Guided Stagewise Pretraining for Plant Genome Foundation Models across 1,000 Species},
  author = {Yang Lin and Jiang Sirong and Li Yubo and Zou Meiling and Xia Yu and Wang Lu and Wu Yingdong and Wang Hao},
  journal = {bioRxiv (Cold Spring Harbor Laboratory)},
  doi = {10.64898/2026.10.22.761197},
  year = {2026},
  keywords = {genomic-foundation-model},
  abstract = { Abstract Genomic language models have advanced DNA sequence analysis, but their applicability to plant-specific tasks and representation changes during pretraining remain poorly characterized. Here, we present Creator 1.0, a 2-billion-parameter parameter plant genome foundation model pretrained on 1,000 plant genomes using phylogeny-guided stagewise pretraining (PGSP). Training comprised 83 consecutive stages and produced 52 cumulative checkpoints associated with distinct plant orders. On GENEB, the stage 83 checkpoint ranked first among 46 models across 10 plant-related tasks, with a mean Matthews correlation coefficient (MCC) of 0.565, and fourth across all 100 tasks. Evaluation of 52 checkpoints on six plant lncRNA tasks identified different optimal stages under full-data, 10-shot and 1-shot settings, corresponding to stages 71, 72 and 29, respectively. Checkpoint performance varied across tasks, without consistent advantages for corresponding plant orders. These findings demonstrate the competitive performance of Creator 1.0 and highlight the potential of PGSP to provide task-adaptable checkpoints for plant genomic applications. },
  url = {https://doi.org/10.64898/2026.10.22.761197}
}

@article{Vaidya2026medpao-vl-multimodal-clinical-agent,
  title = {MedPAO-VL: Interpretable and Protocol-Compliant Agent for Structured Radiology Report Generation},
  author = {Shrish Shrinath Vaidya and Gowthamaan Palani and Minmini Selvam and Gokulraja Srinivasaraja and Ganapathy Krishnamurthi},
  journal = {arXiv (Cornell University)},
  doi = {10.48550/arxiv.2610.21794},
  eprint = {2610.21794},
  year = {2026},
  keywords = {multimodal-clinical-agent},
  abstract = {Despite the remarkable generalization capabilities of Large Language Models, generating clinically accurate and structured radiology reports from medical images remains a significant challenge. Current end-to-end approaches function as black boxes, prone to factual hallucinations and generating ungrounded findings. This lack of reliability and failure to adhere to domain-specific structuring protocols, fundamentally limits their clinical utility. We present MedPAO-VL, a multimodal agent that shifts the paradigm from monolithic generation to explainable, iterative, protocol-compliant structured report generation. Unlike deterministic models, our plan-act-observe loop functions as a goal-oriented agent: it first perceives the Chest X-Ray through an explainable vision module designed to capture inherent diagnostic uncertainty, then iteratively refines the generated report by observing semantic discrepancies and self-correcting its generation for better alignment with visually detected clinical findings. Evaluation of our framework demonstrates that this agentic reasoning improves clinical correctness and completeness, achieving an expert-rated accuracy score of 3.5/5 and a structural score of 4.3/5. By prioritizing pathology specific explainability and iterative refinement over opaque end-to-end mapping, MedPAO-VL offers a transparent and clinically viable alternative for automated structured radiology report generation.},
  url = {https://arxiv.org/abs/2610.21794}
}

@article{Palacios2026cedar-multimodal-clinical-agent,
  title = {Agentic LLM reasoning in pediatric diabetes outcome prediction from multimodal medical records},
  author = {Daniel Palacios and Guantong Qi and Anna Kadi and Natali Borrego and Sukru Aras and Michael L. Ferm and Elizabeth Kubota-Mishra and Maria J. Redondo},
  journal = {arXiv (Cornell University)},
  doi = {10.48550/arxiv.2610.40379},
  eprint = {2610.40379},
  year = {2026},
  keywords = {multimodal-clinical-agent},
  abstract = {Large language model (LLM) agents are proposed for clinical prediction but are untested in pediatrics, where cohorts are small and outcomes are uncommon. Using records from 2,489 youth with type 2 diabetes (T2D) and 4,018 with type 1 diabetes (T1D), spanning structured data, note-derived social determinants and, in T1D, continuous glucose monitoring data, we predicted seven T2D outcomes, four also in T1D, at 24 months from 18 months of follow-up. CEDAR (Clinical Evidence-Driven Agent for Risk-prediction), an evidence-citing, self-auditing LLM pipeline, outperformed trained machine learning in both cohorts (pooled area under the receiver operating characteristic curve 0.815 versus 0.656 to 0.700 in T2D and 0.756 versus 0.603 to 0.631 in T1D), most on the sparsely screened outcomes. Only 4 of 70,246 values it cited did not match the chart. Reading only the evidence and reasoning cited by CEDAR, two pediatric endocrinologists reached the same prediction as CEDAR in about nine of ten cases, agreeing with each other on 90.5\%.},
  url = {https://arxiv.org/abs/2610.40379}
}

@article{Hou2026smart-med-multimodal-clinical-agent,
  title = {Learning When to Collaborate: Selective Multi-Agent Medical Reasoning via Uncertainty-Aware Routing},
  author = {Jiacheng Hou and Xueliang Cui and Dan Lu and Ruxin Wang},
  journal = {arXiv (Cornell University)},
  doi = {10.48550/arxiv.2610.33544},
  eprint = {2610.33544},
  year = {2026},
  keywords = {multimodal-clinical-agent},
  abstract = {Multi-agent systems have emerged as a promising paradigm for multimodal medical reasoning, but existing methods rely on two assumptions that hinder practical deployment: (i) always-active dense collaboration among multiple agents, and (ii) dependence on large cloud-based models that raise privacy and efficiency concerns. In this paper, we challenge both assumptions and propose SMART-Med, a fully local multi-agent method that treats collaboration as a learnable decision rather than a default behavior. Our key insight is that not every medical query requires costly multi-agent deliberation: many can be reliably solved by a single well-trained agent, while only uncertain cases benefit from expert collaboration. Based on this insight, SMART-Med introduces an uncertainty-driven routing mechanism that adaptively decides when to answer directly and when to recruit a small subset of expert agents, effectively converting dense multi-agent reasoning into selective, query-adaptive coordination. To make this routing reliable, we curate a new multimodal medical dataset MedVR-3K with high-quality reasoning traces and a difficulty hierarchy, and then fine-tune local agents using GRPO with two complementary rewards: a certainty-aware accuracy reward and a vision-language reward model for correctness and reasoning quality respectively. Experiments on four medical visual question answering benchmarks show that SMART-Med achieves competitive performance compared to existing MAS approaches while substantially reducing inference cost (reducing inference time by more than 3.8x and token usage by},
  url = {https://arxiv.org/abs/2610.33544}
}

@article{Lu2026heterogeneity-variant-directionX-serendipity,
  title = {Genomic heterogeneity inflates the performance of variant pathogenicity predictions},
  author = {Lu Baiyu and Liu Xueshen and Lin Po-Yu and Brandes Nadav},
  journal = {Nature communications},
  doi = {10.1038/s41467-026-78623-5},
  year = {2026},
  keywords = {directionX-serendipity},
  abstract = { Abstract Recent studies have reported unprecedented accuracy predicting pathogenic variants across the genome, including in noncoding regions, using large deep-learning models trained on vast genomic data. To verify and understand the basis of these reports, we systematically evaluated the prediction accuracy of frontier models over single-nucleotide variants, focusing on general models capable of scoring multiple variant types across coding or noncoding regions. Our evaluations reveal that the performance of genome-wide predictions is severely inflated by mixing variant categories with different baseline prevalences of pathogenic variants. We constructed a benchmark stratified by variant type to identify the best-performing models for each genomic context, determine where reliable predictions remain out of reach, and establish rigorous standards to guide future evaluations. },
  url = {https://doi.org/10.1038/s41467-026-78623-5}
}
